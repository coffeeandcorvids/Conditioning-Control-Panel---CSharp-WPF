<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConditioningControlPanel.Shell.Controls.FeatureCard">
  <Border x:Name="CardBorder"
          Background="#1C1C35"
          BorderBrush="#FF5CA8"
          BorderThickness="1.5"
          CornerRadius="12"
          Padding="10">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- top: icon + on/off dot -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="IconText" FontSize="26" HorizontalAlignment="Center"/>
        <Ellipse Grid.Column="1" x:Name="StatusDot" Width="8" Height="8"
                 VerticalAlignment="Top" HorizontalAlignment="Right" Fill="#2E2E4A"/>
      </Grid>
      <!-- center: label -->
      <TextBlock Grid.Row="1" x:Name="LabelText"
                 FontSize="11" FontWeight="Bold" Foreground="#DF6BA0"
                 TextAlignment="Center" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,4,0,0"/>
      <!-- bottom: quick toggle -->
      <Button Grid.Row="2" x:Name="ToggleBtn"
              HorizontalAlignment="Stretch"
              FontSize="11" Padding="4,4"
              CornerRadius="8" Margin="0,6,0,0"/>
    </Grid>
  </Border>
</UserControl>
